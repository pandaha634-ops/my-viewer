<?xml version="1.0" encoding="utf-8"?>
<!-- Layout used by the Settings dialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== Thumbnail size section ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/thumbnail_size"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/thumbnailSizeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/sizeSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/thumbnail_size_small" />

            <RadioButton
                android:id="@+id/sizeMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/thumbnail_size_medium" />

            <RadioButton
                android:id="@+id/sizeLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/thumbnail_size_large" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <!-- ===== Preferred apps section ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preferred_apps"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preferredAppsCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/clearPreferredAppsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/clear_all_preferred_apps" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <!-- ===== About / build version ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
